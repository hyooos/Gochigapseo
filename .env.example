# 고치갑서 설정
# install.bat이 이 파일을 .env로 복사함. 키 3개(★)만 넣으면 전부 켜짐
# 키 비워 두면 키 없는 모드로 돎 (정해진 문장·버튼, 직선거리 추정)
# 키 넣은 .env는 깃허브·메신저에 올리지 말 것. 자세한 건 docs/llm-setup.md

# ★ LLM 키 (openrouter.ai → Keys)
LLM_API_KEY=
# ★ 카카오 REST 키 (developers.kakao.com → 앱 키). 실제 이동 시간, 식당·숙소 좌표
KAKAO_REST_KEY=
# ★ 카카오맵 JS 키. 앱 설정에 http://localhost:8501 등록 + 카카오맵 ON 해야 뜸
KAKAO_JS_KEY=

# ── 아래는 그대로 두면 됨 ──

APP_NAME=고치갑서

# api / offline. api인데 키 없으면 알아서 offline으로 돎
LLM_MODE=api
# 모델 바꿀 땐 이 두 줄 + 키만 바꾸면 됨
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-6-luna
# 생각 깊이: minimal | low | medium | high (비우면 medium이라 느림)
LLM_REASONING_EFFORT=low

# 비용 제한
LLM_MAX_CALLS_PER_QUESTION=12
LLM_MONTHLY_BUDGET_USD=20
LLM_CACHE=on
# 모델이 function calling 지원 안 하면 off
LLM_TOOL_CALLING=on
# 하위 에이전트도 LLM으로 판단 (off면 규칙만)
AGENT_LLM=on
AGENT_MAX_STEPS=4

# 음성 입력: off / api (음성이 외부로 나가서 기본은 끔)
STT_MODE=off
STT_MODEL=gpt-transcribe

# 장소 주변 사진·볼거리·가게 (인터넷 필요, 좌표만 보냄). 인터넷 없는 PC면 0
PLACE_INFO_ONLINE=1

# 자료 다시 받을 때만 씀 (실행엔 필요 없음, 받아 둔 CSV가 이미 있음)
VISITJEJU_KEY=
KTO_KEY=
JEJU_DATAHUB_KEY=

# sample: 센터 CSV 없으면 [가상] 센터 표로 대신 / real: 넣은 센터 CSV만 씀
# 관광지 자료는 둘 다 실데이터
DATA_MODE=sample